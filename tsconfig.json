{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "node",
    "allowJs": true,
    "checkJs": false,
    "types": [
      "@types/homey"
    ],
    "noEmit": true
  },
  "include": [
    "app.mjs",
    "lib/**/*.mjs",
    "drivers/**/*.mjs",
    "scripts/**/*.mjs",
    "test/**/*.mjs"
  ],
  "exclude": [
    "node_modules",
    ".homeybuild"
  ]
}
