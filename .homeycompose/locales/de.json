  "$capabilities": {
    "solar_forecast_today": {
      "title": "Prognose (heute)"
    },
    "solar_forecast_tomorrow": {
      "title": "Prognose (morgen)"
    },
    "solar_forecast_power": {
      "title": "Prognose Leistung"
    }
  },
  "$flow": {
    "triggers": {
      "solar_forecast_tomorrow_changed": {
        "title": "Die Solarprognose für morgen hat sich geändert",
        "tokens": {
          "forecast": {
            "title": "Prognose"
          },
          "forecast_low": {
            "title": "Prognose (niedrig, P10)"
          },
          "forecast_high": {
            "title": "Prognose (hoch, P90)"
          }
        }
      }
    },
    "conditions": {
      "solar_forecast_tomorrow_above": {
        "title": "Die Solarprognose für morgen liegt über…",
        "titleFormatted": "Die [[estimate]] Solarprognose für morgen !{{liegt|liegt nicht}} über [[kwh]] kWh",
        "args": {
          "estimate": {
            "values": {
              "p50": {
                "title": "wahrscheinlichste"
              },
              "p10": {
                "title": "niedrige (an 9 von 10 Tagen übertroffen)"
              },
              "p90": {
                "title": "hohe (an 1 von 10 Tagen übertroffen)"
              }
            }
          },
          "kwh": {
            "placeholder": "kWh"
          }
        }
      },
      "solar_forecast_power_at_above": {
        "title": "Erwartete Solarleistung zu einer Uhrzeit liegt über…",
        "titleFormatted": "Erwartete Solarleistung um [[time]] !{{liegt|liegt nicht}} über [[watts]] W",
        "hint": "Der nächste Zeitpunkt mit dieser Uhrzeit: heute, oder morgen, wenn er schon vorbei ist.",
        "args": {
          "watts": {
            "placeholder": "W"
          }
        }
      }
    }
  }
