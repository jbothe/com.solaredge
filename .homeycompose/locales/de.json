      "name": "Wechselrichter",
      "settings": {
        "username": {
          "label": "Benutzername"
        },
        "password": {
          "label": "Passwort"
        },
        "forecast_panels": {
          "label": "Anzahl der Module",
          "hint": "Wie viele Module in diese Richtung zeigen. Nur nötig, wenn ein Teil in eine andere Richtung zeigt (siehe die nächsten Gruppen)."
        },
        "forecast_tilt": {
          "label": "Neigung der Module",
          "hint": "Winkel der Module zur Horizontalen. Flach ist 0°, ein typisches Dach 15–35°."
        },
        "forecast_orientation": {
          "label": "Ausrichtung der Module",
          "hint": "Die Richtung, in die die Module zeigen. Die Prognose lernt aus Ihrem Ertrag, die nächstliegende Richtung genügt.",
