{
  "$app": {
    "name": "SolarEdge",
    "description": "Support for SolarEdge Inverters, Meters, EV Chargers and Batteries."
  },
  "$capabilities": {
    "solaredge-home-load-controller-state": {
      "title": "State"
    },
    "solar_forecast_today": {
      "title": "Forecast (today)"
    },
    "solar_forecast_tomorrow": {
      "title": "Forecast (tomorrow)"
    },
    "solar_forecast_power": {
      "title": "Forecast power"
    }
  },
  "$flow": {
    "actions": {
      "home-load-controller-set-state": {
        "title": "Set the state",
        "titleFormatted": "Set the state to [[state]]",
        "args": {
          "state": {
            "title": "State"
          }
        }
      }
    },
    "triggers": {
      "solar_forecast_tomorrow_changed": {
        "title": "Tomorrow's solar forecast changed",
        "tokens": {
          "forecast": {
            "title": "Forecast"
          },
          "forecast_low": {
            "title": "Forecast (low, P10)"
          },
          "forecast_high": {
            "title": "Forecast (high, P90)"
          }
        }
      }
    },
    "conditions": {
      "solar_forecast_tomorrow_above": {
        "title": "Tomorrow's solar forecast is above…",
        "titleFormatted": "Tomorrow's [[estimate]] solar forecast !{{is|is not}} above [[kwh]] kWh",
        "args": {
          "estimate": {
            "values": {
              "p50": {
                "title": "most likely"
              },
              "p10": {
                "title": "low (9 in 10 days beat it)"
              },
              "p90": {
                "title": "high (1 in 10 days beat it)"
              }
            }
          },
          "kwh": {
            "placeholder": "kWh"
          }
        }
      },
      "solar_forecast_power_at_above": {
        "title": "Expected solar power at a time is above…",
        "titleFormatted": "Expected solar power at [[time]] !{{is|is not}} above [[watts]] W",
        "hint": "The next time the clock reads this: today, or tomorrow if it has passed.",
        "args": {
          "watts": {
            "placeholder": "W"
          }
        }
      }
    }
  },
  "$drivers": {
    "battery": {
      "name": "Battery",
      "settings": {
        "username": {
          "label": "Username"
        },
        "password": {
          "label": "Password"
        }
      },
      "capabilitiesOptions": {
        "battery_charging_state": {
          "title": "Battery State"
        },
        "meter_power.charged_today": {
          "title": "Charged (today)"
        },
        "meter_power.discharged_today": {
          "title": "Discharged (today)"
        },
        "meter_power.charged_total": {
          "title": "Charged (total)"
        },
        "meter_power.discharged_total": {
          "title": "Discharged (total)"
        },
        "measure_temperature": {
          "title": "Internal Temperature"
        },
        "battery_soh": {
          "title": "State of Health (SoH)"
        }
      }
    },
    "evcharger": {
      "name": "EV Charger",
      "settings": {
        "username": {
          "label": "Username"
        },
        "password": {
          "label": "Password"
        }
      },
      "capabilitiesOptions": {
        "meter_power.charged": {
          "title": "Total Charged Energy"
        },
        "meter_power.discharged": {
          "title": "Total Discharged Energy"
        }
      }
    },
    "inverter": {
      "name": "Inverter",
      "settings": {
        "username": {
          "label": "Username"
        },
        "password": {
          "label": "Password"
        },
        "forecast_tilt": {
          "label": "Panel tilt",
          "hint": "Angle of the panels from horizontal. Flat is 0°, a typical roof is 15–35°."
        },
        "forecast_orientation": {
          "label": "Panel direction",
          "hint": "The way the panels face. The forecast learns from your production, so an approximate value is fine.",
          "values": {
            "0": {
              "label": "North"
            },
            "45": {
              "label": "North-east"
            },
            "90": {
              "label": "East"
            },
            "135": {
              "label": "South-east"
            },
            "180": {
              "label": "South"
            },
            "225": {
              "label": "South-west"
            },
            "270": {
              "label": "West"
            },
            "315": {
              "label": "North-west"
            },
            "auto": {
              "label": "Automatic (facing the equator)"
            }
          }
        }
      },
      "capabilitiesOptions": {
        "measure_power": {
          "title": "Power"
        },
        "measure_voltage": {
          "title": "AC Voltage"
        },
        "measure_voltage.dc": {
          "title": "DC Voltage"
        },
        "measure_temperature": {
          "title": "Internal Temperature"
        },
        "meter_power": {
          "title": "Generated (total)"
        },
        "meter_power.day": {
          "title": "Generated (today)"
        },
        "meter_power.month": {
          "title": "Generated (this month)"
        },
        "meter_power.year": {
          "title": "Generated (this year)"
        }
      }
    },
    "meter": {
      "name": "Meter",
      "settings": {
        "username": {
          "label": "Username"
        },
        "password": {
          "label": "Password"
        }
      },
      "capabilitiesOptions": {
        "alarm_generic": {
          "title": "Power Outage"
        },
        "meter_power.imported_today": {
          "title": "Imported (today)"
        },
        "meter_power.exported_today": {
          "title": "Exported (today)"
        },
        "meter_power.imported_total": {
          "title": "Imported (total)"
        },
        "meter_power.exported_total": {
          "title": "Exported (total)"
        },
        "measure_power.consumption": {
          "title": "Consumption"
        },
        "measure_power.solar": {
          "title": "Solar Power"
        }
      }
    },
    "home-load-controller": {
      "name": "Home Load Controller",
      "settings": {
        "username": {
          "label": "Username"
        },
        "password": {
          "label": "Password"
        }
      }
    }
  }
}
