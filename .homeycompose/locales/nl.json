  "$capabilities": {
    "solar_forecast_today": {
      "title": "Prognose (vandaag)"
    },
    "solar_forecast_tomorrow": {
      "title": "Prognose (morgen)"
    },
    "solar_forecast_power": {
      "title": "Prognose vermogen"
    }
  },
  "$flow": {
    "triggers": {
      "solar_forecast_tomorrow_changed": {
        "title": "De zonneprognose voor morgen is gewijzigd",
        "tokens": {
          "forecast": {
            "title": "Prognose"
          },
          "forecast_low": {
            "title": "Prognose (laag, P10)"
          },
          "forecast_high": {
            "title": "Prognose (hoog, P90)"
          }
        }
      }
    },
    "conditions": {
      "solar_forecast_tomorrow_above": {
        "title": "De zonneprognose voor morgen is hoger dan…",
        "titleFormatted": "De [[estimate]] zonneprognose voor morgen !{{is|is niet}} hoger dan [[kwh]] kWh",
        "args": {
          "estimate": {
            "values": {
              "p50": {
                "title": "meest waarschijnlijke"
              },
              "p10": {
                "title": "lage (9 op 10 dagen hoger)"
              },
              "p90": {
                "title": "hoge (1 op 10 dagen hoger)"
              }
            }
          },
          "kwh": {
            "placeholder": "kWh"
          }
        }
      },
      "solar_forecast_power_at_above": {
        "title": "Verwacht zonnevermogen op een tijdstip is hoger dan…",
        "titleFormatted": "Verwacht zonnevermogen om [[time]] !{{is|is niet}} hoger dan [[watts]] W",
        "hint": "Het eerstvolgende moment met deze tijd: vandaag, of morgen als het al voorbij is.",
        "args": {
          "watts": {
            "placeholder": "W"
          }
        }
      }
    }
  }
