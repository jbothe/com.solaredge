{
  "$extends": "solaredge",
  "name": {
    "en": "Meter"
  },
  "class": "sensor",
  "capabilities": [
    "measure_power",
    "alarm_generic",
    "meter_power.imported_today",
    "meter_power.exported_today",
    "meter_power.imported_total",
    "meter_power.exported_total"
  ],
  "capabilitiesOptions": {
    "alarm_generic": {
      "title": {
        "en": "Power Outage"
      }
    },
    "meter_power.imported_today": {
      "title": {
        "en": "Imported (today)"
      },
      "preventInsights": true
    },
    "meter_power.exported_today": {
      "title": {
        "en": "Exported (today)"
      },
      "preventInsights": true
    },
    "meter_power.imported_total": {
      "title": {
        "en": "Imported (total)"
      },
      "preventInsights": true
    },
    "meter_power.exported_total": {
      "title": {
        "en": "Exported (total)"
      },
      "preventInsights": true
    }
  },
  "energy": {
    "cumulative": true,
    "cumulativeImportedCapability": "meter_power.imported_total",
    "cumulativeExportedCapability": "meter_power.exported_total"
  }
}