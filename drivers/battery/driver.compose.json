{
  "$extends": "solaredge",
  "class": "battery",
  "capabilities": [
    "measure_battery",
    "measure_power",
    "battery_charging_state",
    "meter_power.charged_today",
    "meter_power.discharged_today",
    "meter_power.charged_total",
    "meter_power.discharged_total",
    "battery_soh"
  ],
  "capabilitiesOptions": {
    "meter_power.charged_today": {
      "preventInsights": true
    },
    "meter_power.discharged_today": {
      "preventInsights": true
    },
    "meter_power.charged_total": {
      "preventInsights": true
    },
    "meter_power.discharged_total": {
      "preventInsights": true
    },
    "battery_soh": {
      "preventInsights": true
    }
  },
  "energy": {
    "homeBattery": true,
    "batteries": [
      "INTERNAL"
    ],
    "approximation": {
      "usageConstant": 60
    },
    "meterPowerImportedCapability": "meter_power.charged_total",
    "meterPowerExportedCapability": "meter_power.discharged_total"
  }
}
